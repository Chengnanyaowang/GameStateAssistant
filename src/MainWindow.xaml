<Window x:Class="GameStateAssistant.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:GameStateAssistant.Controls"
        xmlns:views="clr-namespace:GameStateAssistant.Views"
        Title="GameStateAssistant"
        Icon="pack://application:,,,/Assets/logo.png"
        Width="1220" Height="800"
        MinWidth="1040" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Surface.Base}"
        Foreground="{StaticResource Brush.Text.Primary}"
        FontFamily="{StaticResource Font.Primary}"
        WindowStyle="None"
        ResizeMode="CanResize">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="6" GlassFrameThickness="-1" CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="RootBackdrop" Background="{StaticResource Brush.Surface.MicaTint}" BorderBrush="{StaticResource Brush.Stroke.Subtle}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="2"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="36"/>
            </Grid.RowDefinitions>

            <!-- 1. 顶部标题栏 -->
            <Grid Grid.Row="0" Background="#400F131C">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Image Source="pack://application:,,,/Assets/logo.png" Width="22" Height="22"
                           RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" Margin="0,0,9,0"/>
                    <TextBlock Text="GameStateAssistant" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Primary}" VerticalAlignment="Center"/>
                    <TextBlock Text="v4.0" FontSize="11" Foreground="{StaticResource Brush.Text.Tertiary}" VerticalAlignment="Center" Margin="6,1,0,0"/>
                    <Border x:Name="PrivilegeBadge" Background="#14FFFFFF" CornerRadius="4" Padding="7,2" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="PrivilegeText" Text="标准权限 (按需自动提权)" FontSize="10.5" Foreground="{StaticResource Brush.Text.Secondary}"/>
                    </Border>

                    <!-- CPU 平台模式切换胶囊（自动 / Intel / AMD） -->
                    <Border Background="#16FFFFFF" BorderBrush="{StaticResource Brush.Stroke.Subtle}" BorderThickness="1"
                            CornerRadius="6" Padding="2" Margin="12,0,0,0" VerticalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="PlatformAuto" GroupName="CpuPlatform" Style="{StaticResource FilterPillStyle}"
                                         Content="自动识别" IsChecked="True" Padding="8,2" FontSize="10.5" Checked="PlatformMode_Changed"
                                         ToolTip="自动检测本机 Intel / AMD CPU 平台"/>
                            <RadioButton x:Name="PlatformIntel" GroupName="CpuPlatform" Style="{StaticResource FilterPillStyle}"
                                         Content="Intel" Padding="8,2" FontSize="10.5" Checked="PlatformMode_Changed"
                                         ToolTip="强制切换 Intel 大小核优化与 E 核隔离规则"/>
                            <RadioButton x:Name="PlatformAmd" GroupName="CpuPlatform" Style="{StaticResource FilterPillStyle}"
                                         Content="AMD" Padding="8,2" FontSize="10.5" Checked="PlatformMode_Changed"
                                         ToolTip="强制切换 AMD 锐龙 (7500F / X3D) 芯片组、单通道红线与尾核隔离规则"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="QuietModeBadge" Visibility="Collapsed" Background="{StaticResource Brush.Status.OkBg}" CornerRadius="4" Padding="7,2" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="游戏中 · 已自动静默零动效" FontSize="10.5" Foreground="{StaticResource Brush.Status.Ok}"/>
                    </Border>
                </StackPanel>

                <!-- 窗口控制按钮（Segoe Fluent 符号） -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CaptionButtonStyle}" Content="&#xE921;" Click="Minimize_Click" ToolTip="最小化"/>
                    <Button x:Name="BtnMaximize" Style="{StaticResource CaptionButtonStyle}" Content="&#xE922;" Click="Maximize_Click" ToolTip="最大化"/>
                    <Button Style="{StaticResource CaptionCloseButtonStyle}" Content="&#xE8BB;" Click="CloseWindow_Click" ToolTip="关闭"/>
                </StackPanel>
            </Grid>

            <!-- 扫描微进度条（仅扫描时显示，空闲时完全静止隐藏） -->
            <ProgressBar x:Name="BusyBar" Grid.Row="1" IsIndeterminate="True" Height="2" Visibility="Collapsed" Background="Transparent" Foreground="{StaticResource Brush.Accent}"/>

            <!-- 2. 主体工作区：左侧边栏 + 右侧视图 + 浮层层 -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="228"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧导航栏 -->
                <Border Grid.Column="0" Background="#5512161F" BorderBrush="{StaticResource Brush.Stroke.Subtle}" BorderThickness="0,0,1,0" Padding="12,16">
                    <DockPanel LastChildFill="False">
                        <Grid DockPanel.Dock="Top">
                            <!-- 导航左侧 180ms 滑动青色指示条 -->
                            <Border x:Name="NavIndicator" Width="3" Height="20" CornerRadius="1.5"
                                    Background="{StaticResource Brush.Accent}"
                                    HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Margin="2,11,0,0">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="NavIndicatorTransform" Y="0"/>
                                </Border.RenderTransform>
                            </Border>

                            <StackPanel Margin="8,0,0,0">
                                <RadioButton x:Name="NavOverview" Style="{StaticResource NavItemStyle}" IsChecked="True" Checked="Nav_Changed">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE80F;" FontFamily="{StaticResource Font.Icons}" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock Text="配置总览" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton x:Name="NavSystem" Style="{StaticResource NavItemStyle}" Checked="Nav_Changed">
                                    <DockPanel Width="168">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xEA18;" FontFamily="{StaticResource Font.Icons}" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <TextBlock Text="系统底座优化" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Border x:Name="BadgeSystem" DockPanel.Dock="Right" Visibility="Collapsed" Background="{StaticResource Brush.Status.BadBg}" CornerRadius="9" Padding="6,1" HorizontalAlignment="Right">
                                            <TextBlock x:Name="BadgeSystemText" Text="0" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Brush.Status.Bad}"/>
                                        </Border>
                                    </DockPanel>
                                </RadioButton>

                                <RadioButton x:Name="NavOnline" Style="{StaticResource NavItemStyle}" Checked="Nav_Changed">
                                    <DockPanel Width="168">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource Font.Icons}" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <TextBlock Text="竞技网游专场" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Border x:Name="BadgeOnline" DockPanel.Dock="Right" Visibility="Collapsed" Background="{StaticResource Brush.Status.BadBg}" CornerRadius="9" Padding="6,1" HorizontalAlignment="Right">
                                            <TextBlock x:Name="BadgeOnlineText" Text="0" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Brush.Status.Bad}"/>
                                        </Border>
                                    </DockPanel>
                                </RadioButton>

                                <RadioButton x:Name="NavAaa" Style="{StaticResource NavItemStyle}" Checked="Nav_Changed">
                                    <DockPanel Width="168">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE706;" FontFamily="{StaticResource Font.Icons}" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <TextBlock Text="3A 大作专场" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Border x:Name="BadgeAaa" DockPanel.Dock="Right" Visibility="Collapsed" Background="{StaticResource Brush.Status.WarnBg}" CornerRadius="9" Padding="6,1" HorizontalAlignment="Right">
                                            <TextBlock x:Name="BadgeAaaText" Text="0" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Brush.Status.Warn}"/>
                                        </Border>
                                    </DockPanel>
                                </RadioButton>

                                <RadioButton x:Name="NavVoicePlatform" Style="{StaticResource NavItemStyle}" Checked="Nav_Changed">
                                    <DockPanel Width="168">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE720;" FontFamily="{StaticResource Font.Icons}" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <TextBlock Text="语音 &amp; 平台降占" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Border x:Name="BadgeVoicePlatform" DockPanel.Dock="Right" Visibility="Collapsed" Background="{StaticResource Brush.Status.WarnBg}" CornerRadius="9" Padding="6,1" HorizontalAlignment="Right">
                                            <TextBlock x:Name="BadgeVoicePlatformText" Text="0" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Brush.Status.Warn}"/>
                                        </Border>
                                    </DockPanel>
                                </RadioButton>

                                <RadioButton x:Name="NavCleanup" Style="{StaticResource NavItemStyle}" Checked="Nav_Changed">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74D;" FontFamily="{StaticResource Font.Icons}" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock Text="后台清理 &amp; C盘瘦身" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </Grid>

                        <!-- 左下角运行状态与按钮 -->
                        <StackPanel DockPanel.Dock="Bottom">
                            <Border Background="{StaticResource Brush.Surface.Raised}" BorderBrush="{StaticResource Brush.Stroke.Subtle}" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="活动游戏检测" FontSize="10.5" Foreground="{StaticResource Brush.Text.Tertiary}"/>
                                    <TextBlock x:Name="SideGameText" Text="未检测到游戏" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Brush.Accent}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="SideUptimeText" Text="连续运行: --" FontSize="11" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Button x:Name="BtnRefresh" Style="{StaticResource OutlineButton}" Click="Refresh_Click" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72C;" FontFamily="{StaticResource Font.Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                    <TextBlock Text="立即全盘体检" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnRestore" Style="{StaticResource OutlineButton}" Click="Restore_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7A7;" FontFamily="{StaticResource Font.Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                    <TextBlock Text="还原原始设置" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- 右侧视图宿主 -->
                <Grid Grid.Column="1">
                    <views:OverviewView x:Name="ViewOverview" Visibility="Visible"/>
                    <views:ChecksView x:Name="ViewChecks" Visibility="Collapsed"/>
                    <views:VoicePlatformView x:Name="ViewVoicePlatform" Visibility="Collapsed"/>
                    <views:CleanupView x:Name="ViewCleanup" Visibility="Collapsed"/>

                    <!-- 右下角 Toast 通知宿主 -->
                    <controls:ToastHost x:Name="Toast"/>
                </Grid>
            </Grid>

            <!-- 3. 可展开的操作日志抽屉 -->
            <Border x:Name="LogDrawer" Grid.Row="3" Visibility="Collapsed" Height="150"
                    Background="#0B0E14" BorderBrush="{StaticResource Brush.Stroke.Subtle}" BorderThickness="0,1,0,0" Padding="18,10">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBlock Text="本次会话操作记录" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Primary}"/>
                        <Button DockPanel.Dock="Right" Content="收起" Style="{StaticResource OutlineButton}" Padding="8,2" FontSize="11" Click="ToggleLogDrawer_Click" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <ScrollViewer>
                        <TextBox x:Name="LogTextBox" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource Brush.Text.Secondary}" FontSize="11.5" TextWrapping="Wrap"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- 4. 底部状态栏 -->
            <Border Grid.Row="4" Background="#6012161F" BorderBrush="{StaticResource Brush.Stroke.Subtle}" BorderThickness="0,1,0,0" Padding="16,0">
                <Grid>
                    <TextBlock x:Name="StatusFooterText" Text="就绪 · 正在初始化全盘只读体检..." FontSize="11.5" Foreground="{StaticResource Brush.Text.Secondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,150,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="by chengnanyaowang" FontSize="11" Foreground="{StaticResource Brush.Text.Tertiary}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button Style="{StaticResource OutlineButton}" Padding="9,3" FontSize="11" Click="ToggleLogDrawer_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8FD;" FontFamily="{StaticResource Font.Icons}" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="操作日志" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 5. 顶层深色模态确认对话框（覆盖整个窗口） -->
            <controls:ConfirmDialog x:Name="ConfirmModal" Grid.Row="0" Grid.RowSpan="5"/>
        </Grid>
    </Border>
</Window>
