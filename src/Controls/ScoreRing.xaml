<UserControl x:Class="GameStateAssistant.Controls.ScoreRing"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="104" Height="104">
    <Grid>
        <!-- 底轨 270 度背景弧 -->
        <Path x:Name="TrackPath" Stroke="#18FFFFFF" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

        <!-- 进度弧 -->
        <Path x:Name="ProgressPath" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
            <Path.Stroke>
                <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                    <GradientStop x:Name="GradStart" Color="#FBBF24" Offset="0"/>
                    <GradientStop x:Name="GradEnd" Color="#22D3EE" Offset="1"/>
                </LinearGradientBrush>
            </Path.Stroke>
        </Path>

        <!-- 居中数字与标签（等宽数字不跳动） -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock x:Name="ScoreText" Text="--"
                       FontFamily="{StaticResource Font.Display}"
                       FontSize="30" FontWeight="Bold"
                       Foreground="{StaticResource Brush.Text.Primary}"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="配置合规分" FontSize="10.5"
                       Foreground="{StaticResource Brush.Text.Tertiary}"
                       HorizontalAlignment="Center" Margin="0,-2,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
