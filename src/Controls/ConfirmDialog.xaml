<UserControl x:Class="GameStateAssistant.Controls.ConfirmDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GameStateAssistant"
             Visibility="Collapsed">
    <!-- 深色模态遮罩层 -->
    <Grid Background="#B007090E">
        <Border Width="560" MaxHeight="620"
                Background="{StaticResource Brush.Surface.Raised}"
                BorderBrush="{StaticResource Brush.Stroke.Strong}"
                BorderThickness="1" CornerRadius="12"
                VerticalAlignment="Center" HorizontalAlignment="Center"
                Padding="22">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 标题区 -->
                <StackPanel Grid.Row="0" Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE762;" FontFamily="{StaticResource Font.Icons}"
                                   FontSize="16" Foreground="{StaticResource Brush.Accent}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="DialogTitle" Text="确认拟执行的操作" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource Brush.Text.Primary}"/>
                    </StackPanel>
                    <TextBlock x:Name="DialogSubtitle" Text="你可以取消勾选任意不需要的项目后再继续执行。"
                               FontSize="12" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- 可逐项勾选/取消的操作清单 -->
                <ScrollViewer Grid.Row="1" MaxHeight="340" Margin="0,0,0,12">
                    <ItemsControl x:Name="ActionListControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#0BFFFFFF" BorderBrush="{StaticResource Brush.Stroke.Subtle}"
                                        BorderThickness="1" CornerRadius="8" Padding="11,9" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Checked="ItemCheck_Changed" Unchecked="ItemCheck_Changed"/>
                                        <StackPanel Grid.Column="1" Margin="6,0,10,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{StaticResource Brush.Text.Primary}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Detail}" FontSize="11.5"
                                                       Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <Border Grid.Column="2" VerticalAlignment="Center"
                                                Background="#18FFFFFF" CornerRadius="4" Padding="7,3">
                                            <TextBlock Text="{Binding TagText}" FontSize="10.5"
                                                       Foreground="{StaticResource Brush.Text.Secondary}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 管理员安全提示框 -->
                <Border x:Name="AdminWarningBox" Grid.Row="2" Visibility="Collapsed"
                        Background="{StaticResource Brush.Status.WarnBg}"
                        BorderBrush="#44FBBF24" BorderThickness="1" CornerRadius="8"
                        Padding="11,9" Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEA18;" FontFamily="{StaticResource Font.Icons}" FontSize="14"
                                   Foreground="{StaticResource Brush.Status.Warn}" VerticalAlignment="Top" Margin="0,2,8,0"/>
                        <TextBlock x:Name="AdminWarningText"
                                   Text="所选项目中包含管理员级系统修改，执行时将统一弹出 1 次 UAC 授权，且不会随「还原原始设置」自动撤销。"
                                   FontSize="11.5" Foreground="#FDE68A" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- 底部操作按钮 -->
                <DockPanel Grid.Row="3">
                    <TextBlock x:Name="SelectedSummaryText" Text="已选 0 项" FontSize="12"
                               Foreground="{StaticResource Brush.Text.Secondary}" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="取消" Style="{StaticResource OutlineButton}" Click="Cancel_Click" Width="88" Margin="0,0,8,0"/>
                        <Button x:Name="BtnConfirm" Content="确认执行" Style="{StaticResource PrimaryButton}" Click="Confirm_Click" MinWidth="116"/>
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
