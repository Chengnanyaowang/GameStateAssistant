<UserControl x:Class="GameStateAssistant.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:GameStateAssistant.Controls"
             xmlns:local="clr-namespace:GameStateAssistant">
    <ScrollViewer Padding="24,18">
        <StackPanel>
            <!-- Hero 配置评估区 -->
            <Border Background="{StaticResource Brush.Surface.Raised}"
                    BorderBrush="{StaticResource Brush.Stroke.Subtle}"
                    BorderThickness="1" CornerRadius="12" Padding="22,20" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 270度真弧形评分环 -->
                    <controls:ScoreRing x:Name="ScoreRingControl" Margin="0,0,22,0" VerticalAlignment="Center"/>

                    <!-- 状态总述 + 可点击计数胶囊 -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border x:Name="StatusPillBg" Background="{StaticResource Brush.Status.OkBg}" CornerRadius="5" Padding="8,3">
                                <TextBlock x:Name="StatusPillText" Text="体检中..." FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Brush.Status.Ok}"/>
                            </Border>
                            <TextBlock x:Name="LastScanText" Text="" FontSize="11.5" Foreground="{StaticResource Brush.Text.Tertiary}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>

                        <TextBlock x:Name="HeadlineText" Text="正在读取系统底座与游戏配置..."
                                   FontSize="19" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Primary}"/>
                        <TextBlock x:Name="SubtextText" Text="涵盖：大小核调度、HVCI 安全权衡、16GB 分页文件、IPF 温控、PUBG / CS2 / LOL / 3A"
                                   FontSize="12.5" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,4,0,12" TextWrapping="Wrap"/>

                        <!-- 可点击计数跳转栏 -->
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource OutlineButton}" Padding="10,4" FontSize="11.5" Margin="0,0,8,0" Click="CountOk_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Fill="{StaticResource Brush.Status.Ok}" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="CountOkText" Text="最佳 0"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource OutlineButton}" Padding="10,4" FontSize="11.5" Margin="0,0,8,0" Click="CountBad_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Fill="{StaticResource Brush.Status.Bad}" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="CountBadText" Text="待优化 0"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource OutlineButton}" Padding="10,4" FontSize="11.5" Click="CountOptional_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Fill="{StaticResource Brush.Status.Neutral}" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="CountOptionalText" Text="可选 0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <!-- 右侧操作区：唯一实心按钮 + 描边次按钮 -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="18,0,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Width="226" Margin="0,0,0,8" Click="PreGameBoost_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" FontFamily="{StaticResource Font.Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="赛前备战 (清单确认)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource OutlineButton}" Width="226" Click="FixRecommended_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE90F;" FontFamily="{StaticResource Font.Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="批量修复推荐项" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 4 联实时硬件遥测卡片（含 60 秒 Sparkline 走势线） -->
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 卡片1：显存与温度 -->
                <Border Grid.Column="0" Background="{StaticResource Brush.Surface.Raised}" BorderBrush="{StaticResource Brush.Stroke.Subtle}" BorderThickness="1" CornerRadius="10" Padding="15,14">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock x:Name="GpuCardTitle" Text="显卡显存" FontSize="11.5" Foreground="{StaticResource Brush.Text.Secondary}"/>
                            <TextBlock x:Name="GpuTempText" Text="--°C" FontFamily="{StaticResource Font.Display}" FontSize="11.5" Foreground="{StaticResource Brush.Accent}" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <TextBlock x:Name="GpuMainText" Text="-- MB" FontFamily="{StaticResource Font.Display}" FontSize="19" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Primary}" Margin="0,5,0,2"/>
                        <TextBlock x:Name="GpuSubText" Text="功耗 --W · 负载 --%" FontSize="11" Foreground="{StaticResource Brush.Text.Tertiary}" Margin="0,0,0,8"/>
                        <controls:Sparkline x:Name="GpuSpark" LineColor="#22D3EE" MinValue="0" MaxValue="100" Margin="0,0,0,8"/>
                        <ProgressBar x:Name="GpuProg" Minimum="0" Maximum="100" Value="0"/>
                    </StackPanel>
                </Border>

                <!-- 卡片2：内存 -->
                <Border Grid.Column="2" Background="{StaticResource Brush.Surface.Raised}" BorderBrush="{StaticResource Brush.Stroke.Subtle}" BorderThickness="1" CornerRadius="10" Padding="15,14">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock x:Name="RamCardTitle" Text="系统内存" FontSize="11.5" Foreground="{StaticResource Brush.Text.Secondary}"/>
                            <TextBlock x:Name="RamPctText" Text="--%" FontFamily="{StaticResource Font.Display}" FontSize="11.5" Foreground="{StaticResource Brush.Status.Ok}" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <TextBlock x:Name="RamMainText" Text="-- GB 可用" FontFamily="{StaticResource Font.Display}" FontSize="19" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Primary}" Margin="0,5,0,2"/>
                        <TextBlock x:Name="RamSubText" Text="总计 -- GB" FontSize="11" Foreground="{StaticResource Brush.Text.Tertiary}" Margin="0,0,0,8"/>
                        <controls:Sparkline x:Name="RamSpark" LineColor="#34D399" MinValue="0" MaxValue="100" Margin="0,0,0,8"/>
                        <ProgressBar x:Name="RamProg" Minimum="0" Maximum="100" Value="0" Foreground="{StaticResource Brush.Status.Ok}"/>
                    </StackPanel>
                </Border>

                <!-- 卡片3：C 盘空间 -->
                <Border Grid.Column="4" Background="{StaticResource Brush.Surface.Raised}" BorderBrush="{StaticResource Brush.Stroke.Subtle}" BorderThickness="1" CornerRadius="10" Padding="15,14">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="C 盘可用空间" FontSize="11.5" Foreground="{StaticResource Brush.Text.Secondary}"/>
                            <TextBlock x:Name="DiskPctText" Text="--%" FontFamily="{StaticResource Font.Display}" FontSize="11.5" Foreground="#A78BFA" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <TextBlock x:Name="DiskMainText" Text="-- GB" FontFamily="{StaticResource Font.Display}" FontSize="19" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Primary}" Margin="0,5,0,2"/>
                        <TextBlock x:Name="DiskSubText" Text="总容量 -- GB" FontSize="11" Foreground="{StaticResource Brush.Text.Tertiary}" Margin="0,0,0,8"/>
                        <controls:Sparkline x:Name="DiskSpark" LineColor="#A78BFA" MinValue="0" MaxValue="100" Margin="0,0,0,8"/>
                        <ProgressBar x:Name="DiskProg" Minimum="0" Maximum="100" Value="0" Foreground="#A78BFA"/>
                    </StackPanel>
                </Border>

                <!-- 卡片4：显示器与 CPU -->
                <Border Grid.Column="6" Background="{StaticResource Brush.Surface.Raised}" BorderBrush="{StaticResource Brush.Stroke.Subtle}" BorderThickness="1" CornerRadius="10" Padding="15,14">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock x:Name="CpuCardTitle" Text="显示 &amp; CPU 负载" FontSize="11.5" Foreground="{StaticResource Brush.Text.Secondary}"/>
                            <TextBlock x:Name="CpuPctText" Text="--%" FontFamily="{StaticResource Font.Display}" FontSize="11.5" Foreground="{StaticResource Brush.Status.Warn}" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <TextBlock x:Name="DispMainText" Text="-- Hz" FontFamily="{StaticResource Font.Display}" FontSize="19" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Primary}" Margin="0,5,0,2"/>
                        <TextBlock x:Name="DispSubText" Text="-- × --" FontSize="11" Foreground="{StaticResource Brush.Text.Tertiary}" Margin="0,0,0,8"/>
                        <controls:Sparkline x:Name="CpuSpark" LineColor="#FBBF24" MinValue="0" MaxValue="100" Margin="0,0,0,8"/>
                        <ProgressBar x:Name="CpuProg" Minimum="0" Maximum="100" Value="0" Foreground="{StaticResource Brush.Status.Warn}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 核心指标快览 -->
            <TextBlock Text="核心指标快览" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Primary}" Margin="0,2,0,10"/>
            <ItemsControl x:Name="MatrixList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource Brush.Surface.Raised}"
                                BorderBrush="{StaticResource Brush.Stroke.Subtle}"
                                BorderThickness="1" CornerRadius="10" Margin="0,0,8,8" ClipToBounds="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{Binding Status, Converter={x:Static local:StatusConverters.FgConverter}}"/>
                                <StackPanel Grid.Column="1" Margin="12,10">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Background="#12FFFFFF" CornerRadius="4" Padding="6,2" Margin="0,0,7,0">
                                            <TextBlock Text="{Binding Category}" FontSize="10" Foreground="{StaticResource Brush.Text.Secondary}"/>
                                        </Border>
                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Primary}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding CurrentValue}" FontSize="11.5" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Border Grid.Column="2" VerticalAlignment="Center" Margin="8,0,12,0"
                                        Background="{Binding Status, Converter={x:Static local:StatusConverters.BgConverter}}"
                                        CornerRadius="4" Padding="8,3">
                                    <TextBlock Text="{Binding StatusBadge}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{Binding Status, Converter={x:Static local:StatusConverters.FgConverter}}"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
