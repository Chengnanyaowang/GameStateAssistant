<UserControl x:Class="GameStateAssistant.Views.CleanupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="24,18">
        <StackPanel>
            <!-- 1. 后台进程管理 -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock Text="后台吃显存 / 屏幕钩子程序检测" FontSize="17" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Primary}"/>
                    <TextBlock Text="默认全部不预勾选，由你自行勾选决定；已保护游戏本体、Steam、FanControl、小飞机与 RTSS。" FontSize="12" Foreground="{StaticResource Brush.Text.Secondary}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource OutlineButton}" Content="仅勾选高占用项" Click="SelectHighImpact_Click" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource DangerOutlineButton}" Content="关闭所选后台" Click="CloseProcesses_Click"/>
                </StackPanel>
            </Grid>

            <ItemsControl x:Name="ProcessList" Margin="0,0,0,22">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource Brush.Surface.Raised}"
                                BorderBrush="{StaticResource Brush.Stroke.Subtle}"
                                BorderThickness="1" CornerRadius="9" Padding="12,10" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="128"/>
                                    <ColumnDefinition Width="105"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="96"/>
                                </Grid.ColumnDefinitions>

                                <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanClose}" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Primary}"/>
                                    <TextBlock Text="{Binding Category}" FontSize="11" Foreground="{StaticResource Brush.Text.Tertiary}"/>
                                </StackPanel>

                                <Border Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Left" Background="#12FFFFFF" CornerRadius="4" Padding="7,3">
                                    <TextBlock Text="{Binding TagText}" FontSize="10.5" Foreground="{StaticResource Brush.Accent}"/>
                                </Border>

                                <!-- 内存相对大小条 -->
                                <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <DockPanel>
                                        <TextBlock Text="{Binding MemoryText}" FontFamily="{StaticResource Font.Display}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Primary}"/>
                                        <TextBlock Text="{Binding CpuText}" FontSize="10.5" Foreground="{StaticResource Brush.Text.Tertiary}" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                                    </DockPanel>
                                    <ProgressBar Height="3" Minimum="0" Maximum="3072" Value="{Binding MemoryMb, Mode=OneWay}" Margin="0,4,0,0"/>
                                </StackPanel>

                                <TextBlock Grid.Column="4" Text="{Binding Reason}" FontSize="11.5" Foreground="{StaticResource Brush.Text.Secondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="4,0"/>

                                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding ActionText}" FontSize="11.5" FontWeight="Medium" Foreground="{StaticResource Brush.Text.Secondary}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 2. C 盘安全缓存清理 -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock Text="C 盘安全缓存瘦身" FontSize="17" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Primary}"/>
                    <TextBlock Text="仅扫描可再生临时文件（pip 缓存、Temp、旧局回放与平台更新包），不碰代码与个人文件。" FontSize="12" Foreground="{StaticResource Brush.Text.Secondary}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource OutlineButton}" Content="清理勾选缓存" Click="CleanCaches_Click" VerticalAlignment="Center"/>
            </Grid>

            <ItemsControl x:Name="CacheList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource Brush.Surface.Raised}"
                                BorderBrush="{StaticResource Brush.Stroke.Subtle}"
                                BorderThickness="1" CornerRadius="9" Padding="12,10" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="260"/>
                                    <ColumnDefinition Width="95"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding Available}" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Primary}"/>
                                    <TextBlock Text="{Binding PathDisplay}" FontSize="10.5" Foreground="{StaticResource Brush.Text.Tertiary}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontFamily="{StaticResource Font.Display}" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource Brush.Status.Ok}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="{Binding Description}" FontSize="11.5" Foreground="{StaticResource Brush.Text.Secondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
