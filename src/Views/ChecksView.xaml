<UserControl x:Class="GameStateAssistant.Views.ChecksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:GameStateAssistant.Controls">
    <ScrollViewer Padding="24,18">
        <StackPanel>
            <!-- 顶部标题 + 批量操作按钮 -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock x:Name="SectionTitle" Text="系统底座优化" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Primary}"/>
                    <TextBlock x:Name="SectionSubtitle" Text="" FontSize="12.5" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <Button x:Name="BtnBatchFix" Grid.Column="1" Style="{StaticResource OutlineButton}"
                        Content="批量修复此页待优化项" Click="BatchFix_Click" VerticalAlignment="Center"/>
            </Grid>

            <!-- 分段筛选栏：全部 / 待优化 / 最佳 -->
            <Border Background="{StaticResource Brush.Surface.Raised}"
                    BorderBrush="{StaticResource Brush.Stroke.Subtle}"
                    BorderThickness="1" CornerRadius="8" Padding="4"
                    HorizontalAlignment="Left" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="FilterAll" Style="{StaticResource FilterPillStyle}" Content="全部" IsChecked="True" Checked="Filter_Changed"/>
                    <RadioButton x:Name="FilterAttention" Style="{StaticResource FilterPillStyle}" Content="待优化 / 注意" Checked="Filter_Changed"/>
                    <RadioButton x:Name="FilterOptimal" Style="{StaticResource FilterPillStyle}" Content="最佳" Checked="Filter_Changed"/>
                </StackPanel>
            </Border>

            <!-- 检查卡片列表（全部统一使用 CheckItemCard） -->
            <ItemsControl x:Name="ItemsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <controls:CheckItemCard FixRequested="Card_FixRequested"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 底部空状态提示 -->
            <Border x:Name="EmptyStateBox" Visibility="Collapsed"
                    Background="{StaticResource Brush.Surface.Raised}"
                    BorderBrush="{StaticResource Brush.Stroke.Subtle}"
                    BorderThickness="1" CornerRadius="10" Padding="24" Margin="0,4,0,0">
                <TextBlock Text="当前筛选条件下没有对应的项目。" FontSize="13" Foreground="{StaticResource Brush.Text.Secondary}" HorizontalAlignment="Center"/>
            </Border>

            <!-- 底部专家原则备忘卡 -->
            <Border x:Name="TipsBox" Visibility="Collapsed"
                    Background="#101826" BorderBrush="{StaticResource Brush.Stroke.Subtle}"
                    BorderThickness="1" CornerRadius="10" Padding="15" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock x:Name="TipsTitle" Text="" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Brush.Accent}" Margin="0,0,0,6"/>
                    <TextBlock x:Name="TipsLine1" Text="" FontSize="12" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,2" TextWrapping="Wrap"/>
                    <TextBlock x:Name="TipsLine2" Text="" FontSize="12" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,2" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
